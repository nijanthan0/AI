# PyLearn Backend Environment Configuration
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Database (Async SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./pylearn.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pylearn

# JWT Secret (Paste your Supabase JWT secret from Supabase Dashboard -> Settings -> API)
JWT_SECRET_KEY=pylearn-super-secret-jwt-key-change-in-production-32chars

# Pricing Plans (in INR)
MONTHLY_PRICE_INR=499
ANNUAL_PRICE_INR=3999

# Payment Gateway (Stripe or Razorpay)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
